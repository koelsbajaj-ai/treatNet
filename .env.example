# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
# This file (.env.example) contains placeholders only and is safe to commit.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-side only. Bypasses row-level security entirely — full read/write
# access to every table. Never prefix this with NEXT_PUBLIC_ (that prefix
# is what makes Next.js ship a variable into the browser bundle). Only ever
# read from lib/supabase.ts, which is imported exclusively by app/api/*
# route handlers, never by anything that renders in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
